        "pandas",
        "scikit-learn",
        "threadpoolctl",
        "openpyxl",
        "PySide6",
        "matplotlib",
        "xlrd",
        "torch",
        "skorch",
        "packaging"
      ]
    },
    "full": {
      "title": "完整扩展版",
      "summary": "全部 111 个目录模型，含提升树、HMM、深度网络、UMAP、传统时序，以及 TPE/遗传搜索。",
      "extras": [
        "desktop",
        "search",

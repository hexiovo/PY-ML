{
  "schema_version": 1,
  "default_profile": "standard",
  "profiles": {
    "standard": {
      "title": "标准版",
      "summary": "桌面向导、表格工具与 71 个 scikit-learn 模型；包含 Grid、随机和退火搜索。",
      "extras": ["desktop"],
      "model_sections": ["active_models"],
      "collect_submodules": ["sklearn"],
      "exclude_modules": ["hmmlearn", "skorch", "torch", "optuna", "pymoo", "moocore", "xgboost", "lightgbm", "catboost"],
      "runtime_distributions": [
        "numpy", "scipy", "pandas", "scikit-learn", "threadpoolctl", "openpyxl",
        "PySide6", "matplotlib", "xlrd"
      ]
    },
    "full": {
      "title": "完整扩展版",
      "summary": "标准版能力加 HMM、深度模型、TPE 与遗传搜索。",
      "extras": ["desktop", "search", "sequence", "deep"],
      "model_sections": ["active_models", "deferred_models"],
      "collect_submodules": ["sklearn", "optuna", "pymoo"],
      "exclude_modules": [],
      "runtime_distributions": [
        "numpy", "scipy", "pandas", "scikit-learn", "threadpoolctl", "openpyxl",
        "PySide6", "matplotlib", "xlrd", "hmmlearn", "torch", "skorch", "optuna",
        "pymoo", "moocore"
      ]
    }
  },
  "build_distributions": ["PyInstaller", "pyinstaller-hooks-contrib"]
}

{
  "schema_version": 1,
  "default_profile": "standard",
  "profiles": {
    "standard": {
      "title": "标准版",
      "summary": "桌面向导与 90 个基础模型（84 个 scikit-learn、4 个模型融合、2 个朴素时序基线）；包含 Grid、随机和退火搜索。",
      "extras": [
        "desktop"
      ],
      "model_sections": [
        "active_models"
      ],
      "collect_submodules": [
        "sklearn"
      ],
      "exclude_modules": [
        "hmmlearn",
        "skorch",
        "torch",
        "optuna",
        "pymoo",
        "moocore",
        "xgboost",
        "lightgbm",
        "catboost",
        "statsmodels",
        "umap",
        "numba",
        "llvmlite",
        "pynndescent"
      ],
      "runtime_distributions": [
        "numpy",
        "scipy",
        "pandas",
        "scikit-learn",
        "threadpoolctl",
        "openpyxl",
        "PySide6",
        "matplotlib",
        "xlrd",
        "packaging"
      ]
    },
    "deep": {
      "title": "标准深度版",
      "summary": "标准版能力加 PyTorch/skorch 深度模型；不包含 HMM、TPE、遗传搜索或提升树 SDK。",
      "extras": [
        "desktop",
        "deep"
      ],
      "model_sections": [
        "active_models",
        "deferred_models"
      ],
      "collect_submodules": [
        "sklearn"
      ],
      "exclude_modules": [
        "hmmlearn",
        "optuna",
        "pymoo",
